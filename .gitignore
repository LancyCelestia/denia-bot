# ============================ 密钥 / 本机私有配置 ============================
# 只提交 *.example 模板；真实配置永远不进仓库
nonebot/.env
nonebot/configs/models.yml
nonebot/configs/models.yml.published-sha256
nonebot/configs/.model-publish-*
# 真实人格配置含主人 QQ 等私人信息；仓库只保留 templates.yml.example
nonebot/configs/templates.yml
# 面板加载的当前人格正文：用户私有，必须跨 git pull 保留；只忽略这一个文件
/nonebot/templates/current.jinja2
# 面板写 current.jinja2 时的原子临时文件（正常会立即删除）
/nonebot/templates/.persona-*
tools/*token*.txt
tools/*pass*.txt
tools/*.pem
tools/*.key
tools/atrust-backup/
# 面板登录 SnowLuma WebUI 用的密码；显式列出，别只靠上面的通配规则
tools/snowluma-webui-pass.txt
axonhub/config.yml
axonhub/axonhub.db*
# 解析器登录凭证（扫码或 Cookie 换来的，等同账号凭据）
nonebot/data/media_parser/cookies/
# 公开知识库 Markdown 必须入库；只排除本地私有目录，不忽略 knowledge/*.md
knowledge/本地私有/
!knowledge/*.md
# 协议端登录二维码截图（含登录凭据，绝不能外传）
扫码登录.png
*.qr.png

# 运行时生成的凭据 / 带个人数据的状态
nonebot/data/
snowluma/config/
snowluma/data/
data/
logs/
*.tok
*.cookie

# ============================ 第三方组件（不重复分发）============================
# 协议端二进制、注入模块、内置 Node，以及它们的回滚备份
snowluma/
