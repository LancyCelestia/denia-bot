# 复制成 .env.local 后填写；.env.local 已在 .gitignore 里排除。
# deploy-linux/install.sh 首次运行会自动生成一份带随机密码的 .env.local。

# SnowLuma 镜像。公开镜像不可用或需要私有仓库时改成自己的镜像/镜像站，
# 并在需要时先 docker login。install.sh 在 pull 失败但本地已有镜像时会继续。
SNOWLUMA_IMAGE=motricseven7/snowluma:latest

# 远程桌面（noVNC）密码，扫码时用。不要提交真实密码。
VNC_PASSWD=请改成你自己的强密码

# 端口绑定地址。127.0.0.1 = 只能本机访问（推荐，配 SSH 隧道）。
# 想让同内网其它机器访问再填内网 IP，例如 192.168.1.10。
BIND_ADDR=127.0.0.1

# SnowLuma 数据目录，相对仓库根；默认 ./snowluma。
SNOWLUMA_DATA_DIR=./snowluma

# 0 = 只恢复之前成功接入过的账号；1 = 自动 hook 同一客户端里的其它号。
SNOWLUMA_HOOK_AUTOLOAD=0
