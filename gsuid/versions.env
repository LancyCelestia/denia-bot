# Pinned upstream sources for the gsuid_core deployment.
# Simple KEY=VALUE lines: no `export`, no spaces around `=`.
# Consumed by install.sh (bash) and install.ps1 (PowerShell); scripts read
# these values and never hardcode their own copies.
#
# All upstream projects below are licensed GPL-3.0. They are cloned at runtime
# into gsuid/core and are NOT vendored into this repository.

# gsuid_core (GPL-3.0) - the core service running on 127.0.0.1:8765
GSUID_CORE_REPO=https://github.com/Genshin-bots/gsuid_core.git
GSUID_CORE_SHA=aaa8bd6a6a1061d624e72ffaa547a3f1baa33931

# XutheringWavesUID (GPL-3.0) - 鸣潮 (Wuthering Waves) plugin
XUTHERINGWAVESUID_REPO=https://github.com/Loping151/XutheringWavesUID.git
XUTHERINGWAVESUID_SHA=a17e3154a89f63cb8ce2ef176b07880613d33582

# EndUID (GPL-3.0) - 明日方舟：终末地 (Endfield) plugin
ENDUID_REPO=https://github.com/Loping151/EndUID.git
ENDUID_SHA=a6fff57a527400bd008a85fbf72e49ddac849a14

# RoverSign (GPL-3.0) - 鸣潮 auto sign-in plugin
ROVERSIGN_REPO=https://github.com/Loping151/RoverSign.git
ROVERSIGN_SHA=98be9d36144b46471c5094dd751f8f3b63d623bf

# NoneBot2 adapter installed into the NoneBot venv (PyPI requirement pin)
GENSHINUID_ADAPTER_REQ=nonebot-plugin-genshinuid==6.1.1
